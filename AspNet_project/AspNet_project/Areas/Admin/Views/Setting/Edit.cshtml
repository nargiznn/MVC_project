@model Setting

<div class="container mt-5">
    <h3 class="text-center">Edit Setting</h3>
    <form asp-action="Edit" method="post">
        <div class="form-group">
            <label for="Key">Key</label>
            <input type="text" class="form-control mt-2" value="@Model.Key" readonly />
        </div>
        <div class="form-group">
            <label for="Value">Value</label>
            <input type="text" asp-for="Value" class="form-control mt-2" placeholder="Enter value">
            <span asp-validation-for="Value" class="text-danger"></span>
        </div>

        <button type="submit" class="btn btn-success mt-3">Save Changes</button>
        <a asp-action="Index" class="btn btn-primary mt-3">Cancel</a>
    </form>
</div>
