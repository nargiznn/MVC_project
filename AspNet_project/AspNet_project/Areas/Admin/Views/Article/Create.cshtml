@model Article

<div class="container mt-5">
    <h3 class="text-center">Create New Article</h3>
    <form asp-action="Create" method="post">
        <input type="text" asp-for="Desc" class="form-control mt-5" placeholder="Article Description">
        <span class="text-danger d-block" asp-validation-for="Desc"></span>
        <button type="submit" class="btn btn-success mr-2 mt-3">Submit</button>
        <a asp-action="Index" class="btn btn-primary mx-2 mt-3">Cancel</a>
    </form>
</div>
