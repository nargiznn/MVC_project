@model ProductVM

<div class="container mt-5">
    <h1 class="text-center">@((Model.Id == 0) ? "Create New Product" : "Edit Product")</h1>

    <formm asp-action="Edit" method="post" enctype="multipart/form-data">
        @Html.AntiForgeryToken()

        <div class="form-group">
            <label for="Title">Title</label>
            <input type="text" class="form-control" id="Title" name="Title" value="@Model.Title" required />
        </div>

        <div class="form-group">
            <label for="Info">Info</label>
            <textarea class="form-control" id="Info" name="Info" required>@Model.Info</textarea>
        </div>

        <div class="form-group">
            <label for="MoreInfo">More Info</label>
            <textarea class="form-control" id="MoreInfo" name="MoreInfo">@Model.MoreInfo</textarea>
        </div>

        <div class="form-group">
            <label for="Price">Price</label>
            <input type="number" class="form-control" id="Price" name="Price" value="@Model.Price" step="0.01" required />
        </div>

        <div class="form-group">
            <label for="DiscountPrice">Discount Price</label>
            <input type="number" class="form-control" id="DiscountPrice" name="DiscountPrice" value="@Model.DiscountPrice" step="0.01" />
        </div>

        <div class="form-group">
            <label for="SalesCount">Sales Count</label>
            <input type="number" class="form-control" id="SalesCount" name="SalesCount" value="@Model.SalesCount" required />
        </div>

        <div class="form-group">
            <label for="CategoryId">Category</label>
            @*<select class="form-control" id="CategoryId" name="CategoryId">
                <option value="">Select Category</option>
                @foreach (var category in ViewBag.Categories)
                {
                    <option value="@category.Id" @(category.Id= =Model.CategoryId ? "selected" : "" )>@category.Name</option>
                }
            </select>*@
        </div>

        <div class="form-group">
            <label for="ProductPhotos">Product Images</label>
            <input type="file" class="form-control" id="ProductPhotos" name="productPhotos" multiple />
        </div>

        <h5>Existing Images</h5>
        <div class="existing-images">
            @foreach (var image in Model.ProductImages)
            {
                <div>
                    <img src="~/assets/img/@image.Image" style="width:100px;height:100px" alt="image" />
                    @if (image.IsMain)
                    {
                        <span> (Main Image) </span>
                    }
                    <input type="radio" name="MainImage" value="@image.Image" @(image.IsMain ? "checked" : "") /> Set as Main
                </div>
            }
        </div>

        <button type="submit" class="btn btn-success">Save Product</button>
