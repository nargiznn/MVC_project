@model SingleProductVM

<div class="container mt-5">
    <div class="texts">
        <h4>Category : @Model.Id </h4>
        <h4>Title : @Model.Title </h4>
        <h4>CategoryName : @Model.CategoryName </h4>
        <h4>Info : @Model.Info </h4>
        <h4>MoreInfo : @Model.MoreInfo </h4>
        <h4>Price : @Model.Price </h4>
        <h4>DiscountPrice : @Model.DiscountPrice </h4>
        <h4>SalesCount : @Model.SalesCount </h4>
    </div>

    @if (Model.Images != null && Model.Images.Any())
    {
        @foreach (var item in Model.Images)
        {
            <img src="~/assets/img/@item.Image" style="width:300px;height:200px; @(item.IsMain ? "border:5px solid yellow" : "")" alt="image">
        }
    }
    else
    {
        <p>No images available.</p>
    }

    <a asp-action="Index" class="btn btn-primary mt-5 d-block w-25">Back</a>
</div>
