@model ProductVM

<div class="container mt-5">
    <h1 class="text-center">Create New Product</h1>

    <form asp-action="Create" method="post" enctype="multipart/form-data">
        @Html.AntiForgeryToken()

        <div class="form-group">
            <label for="Title">Title</label>
            <input type="text" class="form-control" id="Title" name="Title" value="@Model?.Title" required />

        </div>

        <div class="form-group">
            <label for="Info">Info</label>
            <textarea class="form-control" id="Info" name="Info" required>@Model.Info</textarea>
        </div>

        <div class="form-group">
            <label for="MoreInfo">More Info</label>
            <textarea class="form-control" id="MoreInfo" name="MoreInfo">@Model.MoreInfo</textarea>
        </div>

        <div class="form-group">
            <label for="Price">Price</label>
            <input type="number" step="0.01" class="form-control" id="Price" name="Price" value="@Model.Price" required />
        </div>

        <div class="form-group">
            <label for="DiscountPrice">Discount Price</label>
            <input type="number" step="0.01" class="form-control" id="DiscountPrice" name="DiscountPrice" value="@Model.DiscountPrice" />
        </div>

        <div class="form-group">
            <label for="SalesCount">Sales Count</label>
            <input type="number" class="form-control" id="SalesCount" name="SalesCount" value="@Model.SalesCount" required />
        </div>

        <div class="form-group">
            <label for="CategoryId">Category</label>
            <select class="form-control" id="CategoryId" name="CategoryId">
                <option value="">Select Category</option>
                @foreach (var category in ViewBag.Categories)
                {
                    <option value="@category.Id">@category.Name</option>
                }

            </select>
        </div>

        <div class="form-group">
            <label for="ProductPhotos">Product Images</label>
            <input type="file" class="form-control" id="ProductPhotos" name="productPhotos" multiple />
        </div>

        <button type="submit" class="btn btn-success">Create Product</button>
    </form>
</div>
