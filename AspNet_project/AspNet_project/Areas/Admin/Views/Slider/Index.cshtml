@model IEnumerable<Slider>

<div class="container mt-5">
    <h1 class="text-center">Slider Images</h1>
    <div class="text-right mb-3">
        <a asp-action="Create" class="btn btn-success">Create New Slider</a>
    </div>
    <div class="table-responsive">
        <table class="table table-bordered table-hover">
            <thead class="thead-light text-center">
                <tr>
                    <th>Image</th>
                    <th style="max-width: 200px;">Options</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <td class="text-center align-middle">
                            <img src="~/assets/img/@item.Image" class="img-thumbnail" style="width:300px; height:auto;" alt="Slider Image">
                        </td>
                        <td class="text-center align-middle">
                            <a asp-action="Detail" asp-route-id="@item.Id" class="btn btn-outline-primary mr-2">Detail</a>
                            <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-outline-secondary mr-2">Edit</a>
                            <form asp-action="Delete" asp-route-id="@item.Id" method="post" class="d-inline">
                                <button type="submit" class="btn btn-outline-danger " onclick="return confirm('Are you sure you want to delete this image?');">Delete</button>
                            </form>
                        </td>
                    </tr>
                }
                @if (!Model.Any())
                {
                    <tr>
                        <td colspan="2" class="text-center text-muted">No slider images found</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
