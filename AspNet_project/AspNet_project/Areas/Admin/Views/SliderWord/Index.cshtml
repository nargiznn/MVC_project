@model IEnumerable<SliderWords>

<div class="container mt-5">
    <h1 class="text-center">Slider Words</h1>
    <div class="text-right mb-3">
        <a asp-action="Create" class="btn btn-success">Create New Slider Word</a>
    </div>
    <div class="table-responsive pt-3">
        <table class="table table-bordered table-hover">
            <thead class="thead-light text-center">
                <tr>
                    <th>Title</th>
                    <th>Main Text</th>
                    <th>Subtitle</th>
                    <th>Options</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <td>@item.Title</td>
                        <td>@item.MainText</td>
                        <td>@item.Subtitle</td>
                        <td class="text-center">
                            <a asp-action="Detail" asp-route-id="@item.Id" class="btn btn-outline-primary btn-sm mr-1">Detail</a>
                            <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-outline-secondary btn-sm mr-1">Edit</a>

                            <!-- Conditionally disable delete for main slider -->
                            @if (!item.IsMain)
                            {
                                <form asp-action="Delete" asp-route-id="@item.Id" method="post" class="d-inline">
                                    <button type="submit" class="btn btn-outline-danger btn-sm" onclick="return confirm('Are you sure you want to delete this item?');">Delete</button>
                                </form>
                            }
                            else
                            {
                                <span class="text-muted">Cannot delete main slider</span>
                            }
                            <form asp-action="ChangeMainStatus" asp-route-id="@item.Id" method="post" class="d-inline">
                                <button type="submit" class="btn @(item.IsMain ? "btn-success" : "btn-danger")"
                                        style="@(item.IsMain ? "pointer-events: none; opacity: 0.5; cursor: not-allowed;" : "")"
                                        @(item.IsMain ? "disabled" : "")>
                                    Change main status
                                </button>
                            </form>
                        </td>
                    </tr>
                }
                @if (!Model.Any())
                {
                    <tr>
                        <td colspan="4" class="text-center text-muted">No slider words found</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>


<style>
    .btn-disabled-custom {
        cursor: not-allowed !important;
        pointer-events: none !important;
        opacity: 0.5 !important;
    }
</style>
