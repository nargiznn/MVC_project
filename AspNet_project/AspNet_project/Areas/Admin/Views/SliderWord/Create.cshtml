@model SliderWords

<div class="container mt-5">
    <h3 class="text-center">Create New Slider Word</h3>
    <form asp-action="Create" method="post">
        <div class="form-group">
            <label for="Title">Title</label>
            <input type="text" asp-for="Title" class="form-control mt-2" placeholder="Enter title">
            <span asp-validation-for="Title" class="text-danger"></span>
        </div>

        <div class="form-group">
            <label for="MainText">Main Text</label>
            <textarea asp-for="MainText" class="form-control mt-2" rows="4" placeholder="Enter main text"></textarea>
            <span asp-validation-for="MainText" class="text-danger"></span>
        </div>

        <div class="form-group">
            <label for="Subtitle">Subtitle</label>
            <input type="text" asp-for="Subtitle" class="form-control mt-2" placeholder="Enter subtitle">
            <span asp-validation-for="Subtitle" class="text-danger"></span>
        </div>

        <button type="submit" class="btn btn-success mt-3">Submit</button>
        <a asp-action="Index" class="btn btn-primary mt-3">Cancel</a>
    </form>
</div>
