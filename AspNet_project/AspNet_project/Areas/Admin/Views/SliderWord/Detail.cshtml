@model SliderWords

<div class="col-md-12">
    <div class="card">
        <div class="header">
            <h4 class="title">Slider Word Details</h4>
        </div>
        <div class="content table-responsive table-full-width">
            <table class="table table-hover table-striped">
                <thead>
                <th>ID</th>
                <th>Title</th>
                <th>Subtitle</th>
                <th>MainText</th>
                </thead>
                <tbody>
                    <tr>
                        <td>@Model.Id</td>
                        <td>@Model.Title</td>
                        <td>@Model.Subtitle</td>
                        <td>@Model.MainText</td>
                    </tr>

                </tbody>
            </table>

        </div>
    </div>
    <div class="form-group mt-4">
        <a asp-action="Index" class="btn btn-primary">Back to List</a>
    </div>
</div>