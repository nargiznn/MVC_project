@model HomeVM
@inject ILayoutService _layoutService;
@{
    Dictionary<string, string> settings = await _layoutService.GetAllSettingAsync();
}
<main>
    <h1 class="position-absolute slider-text-1">@Model.SliderWords.Title</h1>
    <h1 class="position-absolute slider-text-2">@Model.SliderWords.MainText</h1>
    <h1 class="position-absolute slider-text-3">@Model.SliderWords.Subtitle</h1>
    <button class="position-absolute slider-button">View Detail</button>
    <div id="carouselExample" class="carousel slide" data-bs-ride="carousel">
        <div class="carousel-inner">
            @for (int i = 0; i < Model.Sliders.Count; i++)
            {
                string activeElem = "";
                if (Model.Sliders.FirstOrDefault() == Model.Sliders[i])
                {
                    activeElem = "active";
                }
                <div class="carousel-item @activeElem">
                    <img src="~/assets/img/@Model.Sliders[i].Image" class="d-block w-100 img-fluid" alt="Slide 1">
                </div>
            }

        </div>
        <button class="carousel-control-prev" type="button" data-bs-target="#carouselExample" data-bs-slide="prev">
            <span class="carousel-control-prev-icon" aria-hidden="true"></span>
            <span class="visually-hidden">Previous</span>
        </button>
        <button class="carousel-control-next" type="button" data-bs-target="#carouselExample" data-bs-slide="next">
            <span class="carousel-control-next-icon" aria-hidden="true"></span>
            <span class="visually-hidden">Next</span>
        </button>
    </div>

    <section id="home-banner">

        <div class="container h-100">
            <div class="row h-100">
                @foreach (var item in Model.Adverts)
                {
                    <div class="col-6">
                        <img src="~/assets/img/@item.Image" alt="" height="100%" width="100%"
                             class="banner-image img-fluid">
                    </div>
                }
            </div>
        </div>
    </section>
    <section id="our-offer-last-deal" class="mt-3">
        <div class="container">
            <div class="row">
                <div class="col-xs-12 col-lg-6">
                    <div class="row">
                        <div class="col-12 d-flex justify-content-between">
                            <span class="banner-header-text">OUR OFFER</span>
                            <div>
                                <button class="carousel-button"><i class="fa-solid fa-chevron-left"></i></button>
                                <button class="carousel-button"><i class="fa-solid fa-chevron-right"></i></button>
                            </div>
                        </div>
                        <div class="col-12 d-flex justify-content-between">
                            <div class="owl-carousel-1 owl-carousel owl-theme">
                                @foreach (var item in Model.Products.TakeLast(4))
                                {
                                    <div class="">
                                        <div class="big-card">
                                            <h6 class="card-top-title">@item.Title</h6>
                                            <div class="card-img">
                                                <span class="card-tag">
                                                    <span class="card-tag-text">new</span>
                                                </span>
                                                <img src="~/assets/img/@item.ProductImages.FirstOrDefault(i => i.IsMain)?.Image" alt="" class="img-fluid">
                                            </div>
                                            <div class="price w-100">
                                                @if (item.DiscountPrice < item.Price && item.DiscountPrice > 0)
                                                {
                                                    <div class="sale-box">
                                                        <span class="text-center">sale</span>
                                                    </div>

                                                    <div class="price-box">
                                                        <span class="card-sale-price d-inline">$@item.DiscountPrice.ToString("F2")</span>
                                                        <span class="card-discount-price d-inline text-decoration-line-through ml-2">$@item.Price.ToString("F2")</span>
                                                    </div>
                                                }
                                                else
                                                {
                                                    <div class="price-box">
                                                        <span class="card-price d-inline">$@item.Price.ToString("F2")</span>
                                                    </div>
                                                }


                                            </div>
                                            <div class="card-bottom p-2">
                                                <div class="row">
                                                    <div class="col-4">
                                                        <button class="card-button">select options</button>
                                                    </div>
                                                    <div class="col-8 align-items-center">
                                                        <span class="card-description">
                                                            @item.Info
                                                        </span>
                                                        <div class="card-description-icons gap-5 disable">
                                                            <a href=""><i class="fa-solid fa-heart"></i></a>
                                                            <a href=""><i class="fa-solid fa-info"></i></a>
                                                            <a href=""><i class="fa-solid fa-eye"></i></a>
                                                        </div>
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                }
                            </div>
                        </div>
                    </div>
                </div>
                <div class="col-xs-12 col-lg-6">
                    <div class="row">
                        <div class="col-12 d-flex justify-content-between">
                            <span class="banner-header-text">last deal</span>
                            <div>
                                <button class="carousel-button"><i class="fa-solid fa-chevron-left"></i></button>
                                <button class="carousel-button"><i class="fa-solid fa-chevron-right"></i></button>
                            </div>
                        </div>
                        <div class="col-12 d-flex justify-content-between">
                            <div class="owl-carousel owl-carousel-2">
                                @foreach (var item in Model.Products.Take(4))
                                {
                                    <div class="">
                                        <div class="big-card">
                                            <h6 class="card-top-title">@item.Title</h6>
                                            <div class="card-img">
                                                <div class="right-images vis-hidden">
                                                    <h6 class="text-center">
                                                        <a href="">
                                                            <i class="fa-solid fa-chevron-up"></i>
                                                        </a>
                                                    </h6>

                                                    @foreach (var image in item.ProductImages.Where(i => !i.IsMain))
                                                    {
                                                        <div class="col-12 mt-1">
                                                            <img src="~/assets/img/@image.Image" alt="" class="img-fluid">
                                                        </div>

                                                    }
                                                    <h6 class="text-center">
                                                        <a href="">
                                                            <i class="fa-solid fa-chevron-down"></i>
                                                        </a>
                                                    </h6>
                                                </div>
                                                <span class="card-tag">
                                                    <span class="card-tag-text">new</span>
                                                </span>
                                                <img src="~/assets/img/@item.ProductImages.FirstOrDefault(i => i.IsMain)?.Image" alt="" class="img-fluid main-image">
                                            </div>
                                            <div class="price w-100">
                                                @if (item.DiscountPrice < item.Price && item.DiscountPrice > 0)
                                                {
                                                    <div class="sale-box">
                                                        <span class="text-center">sale</span>
                                                    </div>

                                                    <div class="price-box">
                                                        <span class="card-sale-price d-inline">$@item.DiscountPrice.ToString("F2")</span>
                                                        <span class="card-discount-price ">$@item.Price.ToString("F2")</span>
                                                    </div>
                                                }
                                                else
                                                {
                                                    <div class="price-box">
                                                        <span class="card-price d-inline">$@item.Price.ToString("F2")</span>
                                                    </div>
                                                }
       

                                            </div>
                                            <div class="expired-box">
                                                <span class="d-block">Expired</span>
                                            </div>
                                            <div class="card-bottom p-2">
                                                <div class="row">
                                                    <div class="col-4">
                                                        <button data-id="@item.Id" class="card-button add-to-basket ">add to cart</button>
                                                    </div>
                                                    <div class="col-8 align-items-center">
                                                        <span class="card-description">
                                                          @item.Info
                                                        </span>
                                                        <div class="card-description-icons gap-5 disable">
                                                            <a href=""><i class="fa-solid fa-heart"></i></a>
                                                            <a href=""><i class="fa-solid fa-info"></i></a>
                                                            <a href=""><i class="fa-solid fa-eye"></i></a>
                                                        </div>
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                }

                            </div>
                        </div>
                    </div>
                </div>

            </div>
        </div>


    </section>
