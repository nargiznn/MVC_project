    </section>
    <section id="support" class="mt-5">
        <div class="container">
            <div class="row">
                <div class="col-12 col-md-7">
                    <h6 class="text-center mt-5 support-header">buying & selling just got easier!</h6>
                    <h6 class="text-center mt-3 support-description">
                        Aenean sollicitudin, lorem quis bibendum
                        auctor,
                        nisi elit consequat ipsum, nec sagittis sem nibh id elit. Duis sed odio sit amet nibh
                        vulputate
                        cursus a sit amet mauris.
                    </h6>
                    <div class="row mt-5">
                        <div class="col-6 col-md-12 col-lg-6">
                            <div class="d-flex">
                                <button class="support-button">
                                    <h6 class="support-btn-1-header">Call the customer support</h6>
                                    <h6 class="support-btn-1-description mt-3">
                                        <i class="fa-solid fa-mobile-screen-button"></i>@settings["Phone"]
                                    </h6>
                                </button>
                                <h6 class="mt-4 mx-4" style="font-family: 'Raleway'; font-weight: 400;">OR</h6>
                            </div>
                        </div>
                        <div class="col-6 col-md-12 col-lg-6">
                            <button class="support-button">
                                <h6 class="support-btn-2-header">Send us a message</h6>
                                <h6 class="support-btn-2-description mt-3">
                                    <i class="fa-solid fa-envelope"></i>@settings["ContactEmail"]
                                </h6>
                            </button>
                        </div>
                    </div>
                </div>
                <div class="col-12 col-md-5">
                    <img src="~/assets/img/@settings["BackgroundImg"]" class="img-fluid" alt="">
                </div>
            </div>
        </div>
    </section>
    <section id="partners" class="mt-5">
        <div class="container">
            <div class="row">
                <div class="col-12 col-md-6 mt-3">
                    <span class="banner-header-text">Latest News</span>
                    <div class="latest-news">
                        <div class="owl-carousel-3 owl-carousel">
                                @foreach (var newsItem in Model.News)
                                {
                                    <div class="">
                                        <div class="row">
                                            <div class="col-12 col-lg-6">
                                                <img src="./assets/img/@newsItem.Image" alt="" class="img-fluid">
                                            </div>
                                            <div class="col-12 col-lg-6">
                                                <h6 style="font-weight: 900; font-family: 'Raleway'; text-transform: uppercase; font-size: 14px;">
                                                    @newsItem.Title
                                                </h6>
                                                <h6 class="mt-1 latest-news-text" id="desc-@newsItem.Id">
                                                    @newsItem.Desc.TruncateWords(15)
                                                </h6>
                                                <h6 class="mt-1 latest-news-text d-none" id="extra-desc-@newsItem.Id">
                                                    @newsItem.Desc
                                                </h6>
                                                <div class="d-flex justify-content-between align-items-center">
                                                    <span class="latest-news-date mt-1">
                                                        @newsItem.CreateDate.ToString("MMMM dd, yyyy") • 0 comments
                                                    </span>
                                                    <span class="latest-read-more me-4" style="cursor: pointer;" onclick="toggleDescription(@newsItem.Id)">
                                                        Read more <i class="fa-solid fa-right-long"></i>
                                                    </span>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                }
                            </div>
                        </div>
                </div>
    <div class="col-12 col-md-6 mt-3">
        <span class="banner-header-text">Testimonials</span>
        <div class="owl-carousel-4 owl-carousel">

            @foreach (var item in Model.Testimonials)
            {
                <div class="">
                    <div class="testimonials">
                        <h5 class="text-center testimonials-header">
                            @item.Title
                        </h5>
                        <div class="person justify-content-center d-flex mt-3">
                            <div class="image-box">
                                <img src="~/assets/img/@item.Image" alt=""
                                     class="img-fluid pp">
                            </div>
                            <div class="person-info mx-2 mt-2">
                                <span class="person-name">@item.Person</span><br>
                                <span class="person-info">@item.Job</span>
                            </div>
                        </div>
                    </div>
                </div>
            }

        </div>
    </div>
    </div>
    </div>
    </section>
    <section id="brands">
        <div class="container mt-5">
            <span class="banner-header-text">Top Brands</span>
            <div class="brands bg-white">
                <div class="row p-4">
                    @for (int i = 0; i < Model.Brands.Count; i += 2)
                    {
                        <div class="col-6 col-md-4 col-lg-2">
                            <div class="col-6">
                                <img src="~/assets/img/@Model.Brands[i].Image" alt="@Model.Brands[i].Name" class="img-fluid" />
                            </div>

                            @if (i + 1 < Model.Brands.Count)
                            {
                                <div class="col-6">
                                    <img src="~/assets/img/@Model.Brands[i + 1].Image" alt="@Model.Brands[i + 1].Name" class="img-fluid" />
                                </div>
                            }
                        </div>
                    }
                </div>
            </div>
        </div>
    </section>

    <section id="accessories">
        <div class="container p-1">
            <span class="banner-header-text">car accessories</span>
            <div class="row mt-2">
                @for (int i = 0; i < Model.Accessories.Count; i++)
                {
                    <div class="col-12 col-md-6 col-lg-4 d-flex justify-content-between acc-1">
                        <div>
                            <img src="~/assets/img/@Model.Accessories[i].Image" alt="Accessory Image" style="width: 80px; height: 80px;" />
                        </div>
                        <div class="mt-2">
                            <h6 class="accessories-text text-end">@Model.Accessories[i].Name</h6>
                            <ul>
                                @foreach (var item in @Model.Accessories[i].AccessoryCategories)
                                {
                                    <li>@item.Name<i class="fa-solid fa-square"></i></li>
                                }

                            </ul>
                        </div>
                    </div>
                }

            </div>
        </div>
    </section>
</main>
<script>function toggleDescription(id) {
        const descElement = document.getElementById(`desc-${id}`);
        const extraDescElement = document.getElementById(`extra-desc-${id}`);

        if (descElement.classList.contains('d-none')) {
            descElement.classList.remove('d-none');
            extraDescElement.classList.add('d-none');
        } else {
            descElement.classList.add('d-none');
            extraDescElement.classList.remove('d-none');
        }


    }</script>


