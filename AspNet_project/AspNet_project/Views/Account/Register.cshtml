@model RegisterVM
<div class="container mt-5">
    <h1 class="text-center">Register</h1>
    <div class="register-area">
        <form id="register-form" asp-controller="Account" asp-action="Register" method="post">
            <div class="register-form">
                <div class="row">
                    <div class="col-md-12 col-12 mb--15">
                        <label for="name">Full Name</label>
                        <input class="mb-0 form-control" asp-for="FullName" type="text" id="name"
                               placeholder="Enter your full name">
                        <span class="text-danger" asp-validation-for="FullName"></span>
                    </div>
                    <div class="col-md-12 col-12 mb--15">
                        <label for="username">UserName</label>
                        <input class="mb-0 form-control" autocomplete="off" asp-for="UserName" type="text" id="username"
                               placeholder="Enter your UserName">
                        <span class="text-danger" asp-validation-for="UserName"></span>
                    </div>
                    <div class="col-12 mb--20">
                        <label for="email">Email</label>
                        <input class="mb-0 form-control" asp-for="Email" type="email" id="email" placeholder="Enter Your Email Address Here..">
                        <span class="text-danger" asp-validation-for="Email"></span>
                    </div>

                    <div class="col-lg-6 mb--20 position-relative">
                        <label for="password">Password</label>
                        <input asp-for="Password" class="mb-0 form-control" type="password" id="password" placeholder="Enter your password">
                        <i class="fa-solid fa-eye" id="togglePassword" onclick="togglePasswordVisibility('password', 'togglePassword')" style="cursor: pointer; position: absolute; top: 38px; right: 10px;"></i>
                        <span class="text-danger" asp-validation-for="Password"></span>
                    </div>


                    <div class="col-lg-6 mb--20 position-relative">
                        <label for="repeat-password">Repeat Password</label>
                        <input asp-for="ConfirmPassword" class="mb-0 form-control" type="password" id="repeat-password" placeholder="Repeat your password">
                        <i class="fa-solid fa-eye" id="toggleRepeatPassword" onclick="togglePasswordVisibility('repeat-password', 'toggleRepeatPassword')" style="cursor: pointer; position: absolute; top: 38px; right: 10px;"></i>
                        <span class="text-danger" asp-validation-for="ConfirmPassword"></span>
                    </div>

                    <div class="text-danger" asp-validation-summary="All"></div>
                    <div class="col-md-12">
                        <button type="submit" class="btn btn-outlined">Register</button>
                    </div>
                </div>
            </div>
            <a class="nav-link" asp-controller="Account" asp-action="Login">Login</a>
        </form>
    </div>
</div>

<script>function togglePasswordVisibility(passwordId, iconId) {
        const passwordInput = document.getElementById(passwordId);
        const icon = document.getElementById(iconId);

        if (passwordInput.type === "password") {
            passwordInput.type = "text";
            icon.classList.remove("fa-eye");
            icon.classList.add("fa-eye-slash");
        } else {
            passwordInput.type = "password";
            icon.classList.remove("fa-eye-slash");
            icon.classList.add("fa-eye");
        }
    }</script>