
@model BlogVM
<link rel="stylesheet" href="~/assets/css/blog.css">
<main>
    <section id="menu-info" class="bg-black">
        <div class="container">
            <div class="row">
                <div class="col-12 mt-5">
                    <span class="text-light menu-info-text">
                        <a href="index.html">Home</a> > <span style="border-bottom: 1px solid #f0d115;">
                            News
                        </span>
                    </span>
                </div>
            </div>
        </div>
    </section>
    <section id="blog-news">
        <div class="container mt-3">
            <div class="row">
                <div class="col-md-8 bg-white">
                    <div class="row">
                        <div class="col-12 p-2" style="border-bottom: 1px solid rgba(0,0,0,.1);">
                            <span class="blog-news-text">News</span>
                        </div>
                        @foreach (var item in Model.News)
                        {
                            <div class="col-12 p-2">
                                <span class="blog-header-text">
                                    @item.Title
                                </span>
                                <br>
                                <span class="blog-date">Posted by @item.PersonName on @item.CreateDate.ToString("MMMM dd, yyyy")</span>
                            </div>
                            <div class="col-12 p-2">
                                <img src="~/assets/img/@item.Image" class="img-fluid w-100" alt="">
                            </div>
                            <div class="col-12">
                                <span class="blog-footer" id="desc-@item.Id">
                                    @item.Desc.TruncateWords(20)
                                </span>
                                <span class="d-none" id="extra-desc-@item.Id">
                                    @item.Desc
                                </span>
                            </div>
                            <div class="col-12 mt-3 mb-2">
                                <button class="card-button" onclick="toggleDescription(@item.Id)">
                                    read more <i class="fa-solid fa-arrow-right-long"></i>
                                </button>
                            </div>
                        }
                    </div>
                </div>
                <div class="col-md-3 mx-4">
                    <span class="blog-news-text">Recent articles</span>
                    <div class="row">
                        <div class="col-12 bg-white">
                            @foreach (var item in Model.Articles)
                            {
                                <span class="articles-text">
                                    @item.Desc
                                </span>
                                <br>
                                <span class="blog-date">@item.CreateDate.ToString("MMMM dd, yyyy")</span>
                                <br>
                            }
                        </div>

                        <div class="col-12 mt-2">
                            <span class="blog-news-text">Categories</span>
                        </div>
                        <div class="col-12 mt-2 bg-white">
                            @foreach (var item in Model.Categories)
                            {
                                <span class="articles-text">@item.Name</span>
                                <br>
                            }
                        </div>
                    </div>

                </div>
            </div>
        </div>
    </section>

    <script>function toggleDescription(id) {
            const descElement = document.getElementById(`desc-${id}`);
            const extraDescElement = document.getElementById(`extra-desc-${id}`);
            if (descElement.classList.contains('d-none')) {
                descElement.classList.remove('d-none');
                extraDescElement.classList.add('d-none');
            } else {
                descElement.classList.add('d-none');
                extraDescElement.classList.remove('d-none');
            }
        }</script>






